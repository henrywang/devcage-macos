#!/usr/bin/env bash
# wq — one-command agent workflows on top of herdr.
#
# The router (pi in the `inbox` workspace) picks a class and calls this script.
# All herdr orchestration lives here so it is deterministic and costs no tokens.
#
#   wq up                                bring up the inbox + router (idempotent)
#   wq chat       "<message>"            reuse the inbox chat tab
#   wq ask        "<question>"           new inbox tab, scoped to $PWD
#   wq tidy                              close finished ask tabs
#   wq brainstorm <slug> "<idea>"        interactive; note lands in Obsidian
#   wq plan       <slug> "<request>"     plan <-> review loop -> plan.md
#   wq build      <slug> [repo]          worktree, code <-> review loop, commit
#   wq go         <slug>                 push, PR, wait for CI, merge, clean up
#   wq list                              show active wq workspaces
#   wq clean      <slug>                 drop the workspace and scratch dir

set -euo pipefail

WQ_ROOT="${WQ_ROOT:-$HOME/Workspace/.wq}"
VAULT="${WQ_VAULT:-$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/obsidian}"

PLAN_ROUNDS="${WQ_PLAN_ROUNDS:-3}"
CODE_ROUNDS="${WQ_CODE_ROUNDS:-3}"
TURN_TIMEOUT_MS="${WQ_TURN_TIMEOUT_MS:-1800000}"   # 30 min per agent turn

# Roles are `kind:model:level` so either side of a loop can be either agent.
# The rule that matters is that the reviewer is not the model that wrote — which
# way round you assign them is a free choice, not a constraint.
AGENT_PLAN="${WQ_AGENT_PLAN:-claude:opus:high}"
AGENT_CODE="${WQ_AGENT_CODE:-claude:sonnet:high}"
AGENT_REVIEW="${WQ_AGENT_REVIEW:-pi:openai-codex/gpt-5.6-sol:high}"
AGENT_IDEA="${WQ_AGENT_IDEA:-claude:opus:high}"
AGENT_ASK="${WQ_AGENT_ASK:-pi:openai-codex/gpt-5.6-sol:medium}"
AGENT_ROUTER="${WQ_AGENT_ROUTER:-pi:openai-codex/gpt-5.6-sol:medium}"

# Claude Code prompts for permission on first tool use, which stalls an
# unattended loop immediately. These panes work only in a scratch dir or a
# throwaway worktree, so they run unattended. Pi does not gate tools this way.
CLAUDE_PERM="${WQ_CLAUDE_PERMISSION_MODE:-auto}"

die() { printf 'wq: %s\n' "$*" >&2; exit 1; }
log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

need() { command -v "$1" >/dev/null || die "missing dependency: $1"; }
need herdr; need jq; need git

# Captured, not piped: `... | grep -q` exits early, herdr takes SIGPIPE, and
# pipefail turns a healthy server into a failed check.
case "$(herdr status server 2>/dev/null || true)" in
  *"status: running"*) ;;
  *) die "herdr server is not running (start it with: herdr)" ;;
esac

# --- herdr helpers ---------------------------------------------------------
# Every herdr CLI call emits JSON on stdout, so IDs come straight from jq.
# Agents are targeted by pane_id, never by name: names are not unique across
# concurrent workspaces, pane IDs are.

ws_create() {  # label cwd -> "workspace_id pane_id"
  herdr workspace create --label "$1" --cwd "$2" --no-focus \
    | jq -r '.result | "\(.workspace.workspace_id) \(.root_pane.pane_id)"'
}

pane_split() {  # parent_pane cwd -> pane_id
  herdr pane split --pane "$1" --direction right --cwd "$2" --no-focus \
    | jq -r '.result.pane.pane_id'
}

# A freshly created pane is not at an interactive prompt yet, and starting an
# agent in it fails with agent_pane_busy. The gap is short but real, so retry.
agent_start() {  # pane kind name -- args...
  local pane="$1" kind="$2" name="$3"; shift 3
  # Agent names are global in herdr, so a second concurrent workspace starting
  # its own `idea` or `review` pane fails with agent_name_taken. Register under a
  # name qualified by the pane id, which is unique by construction, and keep the
  # short name for the pane label. Nothing here looks agents up by name.
  # herdr rejects anything outside [a-z0-9_-], so fold the pane id's case.
  local agent_name
  agent_name="$name-$(printf '%s' "${pane//:/-}" | tr 'A-Z' 'a-z')"
  local i out
  for i in $(seq 1 15); do
    out="$(herdr agent start "$agent_name" --kind "$kind" --pane "$pane" -- "$@" 2>&1 || true)"
    case "$out" in
      *'"error"'*)
        case "$out" in
          *agent_pane_busy*) sleep 1; continue ;;
          *) printf '%s\n' "$out" >&2; die "could not start $kind in pane $pane" ;;
        esac
        ;;
      *)
        herdr pane rename "$pane" "$name" >/dev/null 2>&1 || true
        return 0
        ;;
    esac
  done
  die "pane $pane never reached a shell prompt; last error: $out"
}

# Start a role from a `kind:model:level` spec. Claude takes --effort and needs a
# permission mode to run unattended; Pi takes --thinking and gates nothing.
start_role() {  # pane spec name
  local pane="$1" spec="$2" name="$3" kind rest model level
  case "$spec" in
    *:*:*) ;;
    *) die "bad agent spec '$spec' — want kind:model:level, e.g. claude:opus:high" ;;
  esac
  kind="${spec%%:*}"; rest="${spec#*:}"
  model="${rest%:*}"; level="${rest##*:}"

  case "$kind" in
    claude) agent_start "$pane" claude "$name" \
              --model "$model" --effort "$level" --permission-mode "$CLAUDE_PERM" ;;
    pi)     agent_start "$pane" pi "$name" \
              --model "$model" --thinking "$level" ;;
    *)      die "unsupported agent kind '$kind' in spec '$spec' (want claude or pi)" ;;
  esac
}

# `agent start` returns once the process is launched, not once its TUI accepts
# input. A prompt sent into that gap is dropped — the agent just sits at an empty
# composer — so wait for herdr to report `interactive_ready` before every prompt.
agent_ready() {  # pane
  local i ready
  for i in $(seq 1 60); do
    ready="$(herdr agent list 2>/dev/null | jq -r --arg p "$1" \
      '.result.agents[]? | select(.pane_id==$p) | .interactive_ready' 2>/dev/null || true)"
    [ "$ready" = "true" ] && return 0
    sleep 1
  done
  die "agent in pane $1 never became ready for input"
}

agent_state() {  # pane -> "<status> <state_change_seq>"
  local s
  s="$(herdr agent list 2>/dev/null | jq -r --arg p "$1" \
    '.result.agents[]? | select(.pane_id==$p)
     | "\(.agent_status // "unknown") \(.state_change_seq // 0)"' 2>/dev/null || true)"
  printf '%s' "${s:-unknown 0}"
}

# Claude Code asks "Is this a project you created or one you trust?" the first
# time it runs in a directory — which is every pane wq starts, since the scratch
# dir and the build worktree are both new. herdr reads readiness off the prompt
# box, and the dialog's option list draws one, so the pane reports ready while
# the only input it accepts is an answer. A prompt sent into that dialog is
# swallowed whole and its Enter confirms the highlighted option.
#
# Answer it here instead. Every directory wq starts an agent in is one it just
# created or one the caller named on the command line, so the answer is yes.
TRUST_DIALOG='Yes, I trust this folder'

settle() {  # pane
  local i screen
  for i in $(seq 1 20); do
    screen="$(herdr agent read "$1" --source visible --lines 40 2>/dev/null || true)"
    case "$screen" in
      *"$TRUST_DIALOG"*)
        herdr agent send-keys "$1" enter >/dev/null 2>&1 || true
        sleep 1
        ;;
      *) return 0 ;;
    esac
  done
  die "pane $1 is still asking whether to trust its directory; attach with: herdr agent attach $1"
}

# `herdr agent prompt` reports whether herdr accepted the request, not whether
# the agent took the text: a TUI mid-startup or sitting on a dialog drops it
# without a trace. Claude Code keeps drawing a composer for tens of seconds
# after it answers the trust dialog while still discarding everything typed into
# it, and nothing in its status, title, or screen distinguishes that pane from a
# working one — so delivery has to be confirmed, not predicted.
#
# state_change_seq is the receipt: an agent that took a prompt leaves idle.
# Nothing moved after ten seconds means nothing was delivered, so clear whatever
# is in the composer and try again.
PROMPT_ATTEMPTS="${WQ_PROMPT_ATTEMPTS:-5}"

deliver() {  # pane text
  local pane="$1" text="$2" attempt i out was was_st now
  agent_ready "$pane"
  for attempt in $(seq 1 "$PROMPT_ATTEMPTS"); do
    settle "$pane"

    was="$(agent_state "$pane")"; was_st="${was%% *}"; was="${was##* }"
    out="$(herdr agent prompt "$pane" "$text" 2>&1 || true)"
    case "$out" in
      *'"error"'*)
        printf '%s\n' "$out" >&2
        die "prompt rejected for pane $pane"
        ;;
    esac

    for i in $(seq 1 10); do
      now="$(agent_state "$pane")"
      [ "${now##* }" != "$was" ] && return 0
      sleep 1
    done

    # A turn that starts late looks exactly like a dropped prompt until the last
    # read, which may land after the poll gave up. Compare the status against the
    # one this attempt started from, not against a fixed list: a warm pane sits
    # in `done` from its previous turn, so `done` here proves nothing.
    now="$(agent_state "$pane")"
    [ "${now%% *}" != "$was_st" ] && return 0

    log "pane $pane did not take the prompt — clearing and retrying ($attempt/$PROMPT_ATTEMPTS)"
    herdr agent send-keys "$pane" esc >/dev/null 2>&1 || true
    sleep 1
  done
  die "pane $pane never took the prompt; attach with: herdr agent attach $pane"
}

# Fire and forget: chat, ask, and brainstorm want the answer to arrive in the
# tab, not to block this script. Delivery is still confirmed — a dropped prompt
# in a tab you are not watching is exactly the failure that hides.
send() { deliver "$1" "$2"; }

# Wait for a turn to end. `done` is the state a finished turn lands in, but it
# does not stay there — a pane that has been read settles back to `idle`, and
# waiting on `done` alone then hangs for the full turn timeout on work that
# finished minutes ago. Idle is only ambiguous before the agent picks the prompt
# up, and deliver() has already proved it did, so idle here means finished.
# Confirm it holds, because a pane can flash idle between steps of a turn.
wait_settled() {  # pane -> status
  local pane="$1" out st deadline
  deadline=$(( $(date +%s) + TURN_TIMEOUT_MS / 1000 ))
  while :; do
    out="$(herdr agent wait "$pane" --until done --until blocked --until idle \
      --timeout "$TURN_TIMEOUT_MS" 2>&1 || true)"
    case "$out" in
      *'"error"'*)
        printf '%s\n' "$out" >&2
        die "waiting on pane $pane failed"
        ;;
    esac

    st="$(printf '%s' "$out" | jq -r '.result.agent.agent_status // "unknown"' 2>/dev/null || echo unknown)"
    [ "$st" = "idle" ] || { printf '%s' "$st"; return 0; }

    sleep 3
    st="$(agent_state "$pane")"; st="${st%% *}"
    case "$st" in
      idle|done|blocked) printf '%s' "$st"; return 0 ;;
    esac
    [ "$(date +%s)" -lt "$deadline" ] \
      || die "pane $pane never finished its turn; attach with: herdr agent attach $pane"
  done
}

# Send a prompt and block until the agent finishes. `blocked` means the agent is
# sitting on a question, so surface that as itself rather than letting it fall
# through as a mysteriously missing output file.
ask() {  # pane text
  local st
  deliver "$1" "$2"
  st="$(wait_settled "$1")"
  if [ "$st" = "blocked" ]; then
    printf '\n--- pane %s ---\n%s\n\n' "$1" \
      "$(herdr agent read "$1" --source visible --lines 25 2>/dev/null || true)" >&2
    die "agent in pane $1 is waiting for input (see above); attach with: herdr agent attach $1"
  fi
}

# Terminal state is a heuristic; a file on disk is not. Every agent turn that is
# supposed to produce output is confirmed by the file actually changing.
expect_file() {  # path before_mtime description
  local f="$1" before="$2" what="$3" now
  now="$(stat -f %m "$f" 2>/dev/null || echo 0)"
  [ -s "$f" ] || die "$what: $f was not written"
  [ "$now" != "$before" ] || die "$what: $f was not updated this round"
}

mtime() { stat -f %m "$1" 2>/dev/null || echo 0; }

notify() { herdr notification show "$1" --body "$2" --sound done >/dev/null 2>&1 || true; }

slug_dir() { printf '%s/%s' "$WQ_ROOT" "$1"; }

# --- inbox tabs ------------------------------------------------------------
# chat and ask run in their own tab inside the inbox workspace, never in the
# router pane. The router only classifies, so its context stays flat no matter
# how many questions you ask; answers — and the file reads behind them — land in
# a tab you can close.

INBOX_LABEL="${WQ_INBOX_LABEL:-inbox}"

inbox_ws() {
  local id
  id="$(herdr api snapshot | jq -r --arg l "$INBOX_LABEL" \
    '.result.snapshot.workspaces[] | select(.label==$l) | .workspace_id' | head -1)"
  [ -n "$id" ] || die "no workspace labelled '$INBOX_LABEL' — create it with: herdr workspace create --label $INBOX_LABEL --cwd ~ --focus"
  printf '%s' "$id"
}

tab_pane_by_label() {  # workspace label -> pane_id (empty if absent)
  herdr api snapshot | jq -r --arg w "$1" --arg l "$2" '
    .result.snapshot as $s
    | ($s.tabs[] | select(.workspace_id==$w and .label==$l) | .tab_id) as $t
    | $s.panes[] | select(.tab_id==$t) | .pane_id' 2>/dev/null | head -1
}

tab_create() {  # workspace label cwd -> pane_id
  herdr tab create --workspace "$1" --label "$2" --cwd "$3" --no-focus \
    | jq -r '.result.root_pane.pane_id'
}

# Bring the inbox up. Idempotent by design: every step checks before it acts, so
# running this when everything is already fine costs one snapshot and changes
# nothing. That is what makes it safe to bind to a key or a shell startup.
cmd_up() {
  local ws pane ids
  ws="$(herdr api snapshot | jq -r --arg l "$INBOX_LABEL" \
    '.result.snapshot.workspaces[] | select(.label==$l) | .workspace_id' | head -1)"

  if [ -z "$ws" ]; then
    ids="$(ws_create "$INBOX_LABEL" "$HOME")"
    ws="${ids%% *}"; pane="${ids#* }"
    herdr tab rename "$(herdr pane get "$pane" | jq -r .result.pane.tab_id)" router \
      >/dev/null 2>&1 || true
    log "created workspace '$INBOX_LABEL'"
  else
    pane="$(tab_pane_by_label "$ws" router)"
    [ -n "$pane" ] || pane="$(tab_create "$ws" router "$HOME")"
  fi

  if herdr agent list | jq -e --arg p "$pane" \
      '.result.agents[]? | select(.pane_id==$p)' >/dev/null 2>&1; then
    log "router already running"
  else
    start_role "$pane" "$AGENT_ROUTER" router
    log "router started"
  fi

  herdr workspace focus "$ws" >/dev/null 2>&1 || true
  herdr pane focus "$pane" >/dev/null 2>&1 || true
}

# chat and ask do not block: you want to watch the answer arrive, not wait on a
# script. Prompt without --wait, focus the tab, return.
cmd_chat() {
  local msg="$*"; [ -n "$msg" ] || die 'usage: wq chat "<message>"'
  local ws; ws="$(inbox_ws)"

  # One long-lived chat tab, reused. Follow-ups ("what about tomorrow?") only
  # make sense with the previous turn still in context, and a fresh tab per
  # throwaway question would bury the workspace in tabs.
  local pane; pane="$(tab_pane_by_label "$ws" chat)"
  if [ -z "$pane" ]; then
    pane="$(tab_create "$ws" chat "$HOME")"
    start_role "$pane" "$AGENT_ASK" chat
  fi

  send "$pane" "$msg"
  herdr pane focus "$pane" >/dev/null 2>&1 || herdr workspace focus "$ws" >/dev/null 2>&1 || true
}

cmd_ask() {
  local q="$*"; [ -n "$q" ] || die 'usage: wq ask "<question>" [--cwd <dir>]'
  local ws; ws="$(inbox_ws)"

  # A fresh tab per question, because the file reads behind an answer are what
  # would otherwise accumulate. Close it when you are done reading.
  local label; label="ask-$(date +%H%M%S)"
  local pane; pane="$(tab_create "$ws" "$label" "${WQ_ASK_CWD:-$PWD}")"
  start_role "$pane" "$AGENT_ASK" "$label"

  send "$pane" "$q"
  herdr pane focus "$pane" >/dev/null 2>&1 || herdr workspace focus "$ws" >/dev/null 2>&1 || true
  log "tab $label — close it with: wq tidy"
}

# ask tabs accumulate. Close the idle ones; leave anything still working.
cmd_tidy() {
  local ws; ws="$(inbox_ws)"
  local n=0 tab
  while read -r tab; do
    [ -n "$tab" ] || continue
    herdr tab close "$tab" >/dev/null 2>&1 && n=$((n + 1)) || true
  done <<EOF
$(herdr api snapshot | jq -r --arg w "$ws" '
  .result.snapshot.tabs[]
  | select(.workspace_id==$w and (.label | startswith("ask-")))
  | select(.agent_status != "working")
  | .tab_id')
EOF
  log "closed $n ask tab(s)"
}

# Reviewers end their file with a machine-readable verdict so convergence is a
# grep, not an interpretation. Anything that is not an explicit approval is
# treated as "keep going".
approved() { grep -qE '^VERDICT: APPROVED[[:space:]]*$' "$1"; }

REVIEW_PROTOCOL='Classify each finding as BLOCKING or NON-BLOCKING. Be adversarial: your job is to find what is wrong, not to be agreeable. End the file with exactly one line, no other text after it: "VERDICT: APPROVED" if there are no BLOCKING findings, otherwise "VERDICT: CHANGES".'

# --- brainstorm ------------------------------------------------------------
cmd_brainstorm() {
  local slug="${1:?usage: wq brainstorm <slug> \"<idea>\"}"; shift
  local idea="$*"; [ -n "$idea" ] || die "describe the idea"
  [ -d "$VAULT" ] || die "Obsidian vault not found: $VAULT"

  local note="$VAULT/inbox/$(date +%F)-$slug.md"
  mkdir -p "$VAULT/inbox"
  [ -e "$note" ] || cat > "$note" <<EOF
---
tags: [brainstorm]
date: $(date +%F)
status: seed
---

# $slug

$idea
EOF

  local ids; ids="$(ws_create "bs-$slug" "$VAULT")"
  local pane="${ids#* }"
  start_role "$pane" "$AGENT_IDEA" idea

  # Interactive by design: brainstorming is worth staying in the room for, and a
  # critic pane at this stage kills the divergence you came for.
  send "$pane" "We are brainstorming. Keep the running note at $note current as we talk: structure it, keep the good branches, prune the dead ones, and record open questions. Do not ask permission before each edit. Preserve the YAML frontmatter. Start by expanding on this idea and offering three angles I have not considered:

$idea"

  herdr workspace focus "${ids%% *}" >/dev/null 2>&1 || true
  log "brainstorm pane ready — note: $note"
}

# --- plan ------------------------------------------------------------------
cmd_plan() {
  local slug="${1:?usage: wq plan <slug> \"<request>\"}"; shift
  local request="$*"; [ -n "$request" ] || die "describe the request"

  local dir; dir="$(slug_dir "$slug")"; mkdir -p "$dir"
  local plan="$dir/plan.md" review="$dir/review.md"
  printf '%s\n' "$request" > "$dir/request.md"

  local ids; ids="$(ws_create "plan-$slug" "$dir")"
  local ws="${ids%% *}" p_plan="${ids#* }"
  herdr tab rename "$(herdr pane get "$p_plan" | jq -r .result.pane.tab_id)" task >/dev/null 2>&1 || true
  local p_rev; p_rev="$(pane_split "$p_plan" "$dir")"

  start_role "$p_plan" "$AGENT_PLAN"   plan
  start_role "$p_rev"  "$AGENT_REVIEW" review

  log "round 1: drafting plan"
  local t; t="$(mtime "$plan")"
  ask "$p_plan" "Write an implementation plan for the request in $dir/request.md. Investigate before proposing. Write the plan to $plan as markdown with sections: Objective, Findings, Approach, Files Affected, Validation, Risks, Open Questions. Write the file — do not print the plan in chat."
  expect_file "$plan" "$t" "planner"

  local round=1
  while :; do
    log "round $round: review"
    t="$(mtime "$review")"
    # The reviewer gets a path, never a pasted plan. Passing content between
    # panes is the single largest token sink in a loop like this.
    ask "$p_rev" "Review the plan at $plan against the request in $dir/request.md. Write your review to $review. $REVIEW_PROTOCOL"
    expect_file "$review" "$t" "reviewer"

    if approved "$review"; then
      log "approved in round $round"
      break
    fi
    if [ "$round" -ge "$PLAN_ROUNDS" ]; then
      log "round limit ($PLAN_ROUNDS) reached with findings outstanding"
      break
    fi

    round=$((round + 1))
    log "round $round: revising plan"
    t="$(mtime "$plan")"
    ask "$p_plan" "The reviewer raised findings in $review. Address every BLOCKING finding and update $plan in place. If you disagree with a finding, say so in the Open Questions section rather than silently ignoring it."
    expect_file "$plan" "$t" "planner"
  done

  notify "wq plan: $slug" "Plan ready for your review"
  log "plan:   $plan"
  log "review: $review"
  log "next:   wq build $slug <repo>"
}

# --- build -----------------------------------------------------------------
cmd_build() {
  local slug="${1:?usage: wq build <slug> [repo]}"
  local repo="${2:-$PWD}"
  local dir; dir="$(slug_dir "$slug")"
  local plan="$dir/plan.md"
  [ -s "$plan" ] || die "no plan at $plan — run: wq plan $slug \"...\""
  repo="$(cd "$repo" && git rev-parse --show-toplevel)" || die "not a git repo: $repo"

  local branch="wq/$slug"
  local wt_path="$repo-worktrees/$slug"
  local review="$dir/code-review.md" diff="$dir/diff.patch"

  log "creating worktree $branch"
  git -C "$repo" fetch origin
  local ws; ws="$(herdr worktree create --cwd "$repo" --branch "$branch" \
      --base origin/main --path "$wt_path" --label "$slug" --no-focus --json \
    | jq -r '.result.workspace.workspace_id')"
  printf '%s\n%s\n%s\n' "$repo" "$branch" "$wt_path" > "$dir/build.env"

  local p_code; p_code="$(herdr api snapshot \
    | jq -r --arg w "$ws" '.result.snapshot.panes[] | select(.workspace_id==$w) | .pane_id' | head -1)"
  local p_rev; p_rev="$(pane_split "$p_code" "$wt_path")"

  start_role "$p_code" "$AGENT_CODE"   code
  start_role "$p_rev"  "$AGENT_REVIEW" review

  log "implementing"
  ask "$p_code" "Implement the approved plan at $plan in this worktree ($wt_path, branch $branch). Follow the repository's own conventions and instruction files. Run the tests. Commit your work with a clear message. Do not push and do not open a pull request."

  local round=1
  while :; do
    git -C "$wt_path" diff origin/main...HEAD > "$diff"
    [ -s "$diff" ] || die "no changes committed on $branch"

    log "round $round: code review"
    local t; t="$(mtime "$review")"
    # Review the diff, not the repository. A reviewer that re-reads the whole
    # tree every round triples the cost of a build for no extra signal.
    ask "$p_rev" "Review the diff at $diff against the plan at $plan. Read files from the worktree only when the diff alone is not enough to judge a change. Write your review to $review. $REVIEW_PROTOCOL"
    expect_file "$review" "$t" "reviewer"

    if approved "$review"; then
      log "code approved in round $round"
      break
    fi
    if [ "$round" -ge "$CODE_ROUNDS" ]; then
      notify "wq build: $slug" "Stopped after $CODE_ROUNDS rounds with findings outstanding"
      log "round limit ($CODE_ROUNDS) reached with findings outstanding — not proceeding"
      log "review: $review"
      exit 2
    fi

    round=$((round + 1))
    log "round $round: fixing"
    ask "$p_code" "The reviewer raised findings in $review. Fix every BLOCKING finding, re-run the tests, and commit. If you disagree with a finding, reply explaining why rather than silently ignoring it."
  done

  notify "wq build: $slug" "Diff ready for your review"
  log "worktree: $wt_path"
  log "diff:     $diff"
  log "next:     wq go $slug"
}

# --- go: push, PR, CI, merge, clean up -------------------------------------
cmd_go() {
  local slug="${1:?usage: wq go <slug>}"
  local dir; dir="$(slug_dir "$slug")"
  [ -s "$dir/build.env" ] || die "no build for $slug — run: wq build $slug"
  need gh

  local repo branch wt_path
  { read -r repo; read -r branch; read -r wt_path; } < "$dir/build.env"

  log "pushing $branch"
  git -C "$wt_path" push -u origin "$branch"

  log "opening pull request"
  gh pr create --repo "$(gh repo view --json nameWithOwner -q .nameWithOwner --cwd "$wt_path" 2>/dev/null || true)" \
    --head "$branch" --base main --fill 2>/dev/null \
    || git -C "$wt_path" ls-remote --exit-code origin "$branch" >/dev/null \
    && (cd "$wt_path" && gh pr create --head "$branch" --base main --fill || true)

  local pr; pr="$(cd "$wt_path" && gh pr view --json number -q .number)"
  log "PR #$pr — waiting for CI"

  # Watch CI in the shell. An agent polling `gh pr checks` in a loop is the most
  # expensive possible way to sit and wait for nothing.
  if ! (cd "$wt_path" && gh pr checks --watch --fail-fast); then
    notify "wq go: $slug" "CI failed on PR #$pr"
    die "CI failed on PR #$pr — fix, then re-run: wq go $slug"
  fi

  log "merging PR #$pr"
  (cd "$wt_path" && gh pr merge "$pr" --squash --delete-branch)

  log "refreshing $repo"
  git -C "$repo" fetch origin main
  git -C "$repo" rebase origin/main

  log "cleaning up"
  herdr worktree remove --workspace "$(herdr api snapshot \
    | jq -r --arg l "$slug" '.result.snapshot.workspaces[] | select(.label==$l) | .workspace_id' | head -1)" \
    --force >/dev/null 2>&1 || true
  git -C "$repo" branch -D "$branch" 2>/dev/null || true

  notify "wq go: $slug" "PR #$pr merged"
  log "merged PR #$pr"
}

# --- housekeeping ----------------------------------------------------------
cmd_list() {
  herdr api snapshot | jq -r '.result.snapshot.workspaces[]
    | select(.label | test("^(bs|plan)-") or (. as $l | false))
    | "\(.workspace_id)\t\(.label)\t\(.agent_status)"'
  printf '\nscratch: %s\n' "$WQ_ROOT"
  ls -1 "$WQ_ROOT" 2>/dev/null || true
}

cmd_clean() {
  local slug="${1:?usage: wq clean <slug>}"
  local id
  for label in "plan-$slug" "bs-$slug" "$slug"; do
    id="$(herdr api snapshot | jq -r --arg l "$label" \
      '.result.snapshot.workspaces[] | select(.label==$l) | .workspace_id' | head -1)"
    [ -n "$id" ] && herdr workspace close "$id" >/dev/null 2>&1 || true
  done
  rm -rf "$(slug_dir "$slug")"
  log "cleaned $slug"
}

# --- dispatch --------------------------------------------------------------
mkdir -p "$WQ_ROOT"
cmd="${1:-}"; shift || true
case "$cmd" in
  up)            cmd_up "$@" ;;
  chat)          cmd_chat "$@" ;;
  ask)           cmd_ask "$@" ;;
  tidy)          cmd_tidy "$@" ;;
  brainstorm|bs) cmd_brainstorm "$@" ;;
  plan)          cmd_plan "$@" ;;
  build)         cmd_build "$@" ;;
  go)            cmd_go "$@" ;;
  list|ls)       cmd_list "$@" ;;
  clean|rm)      cmd_clean "$@" ;;
  ""|-h|--help)  sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)             die "unknown command: $cmd (try: wq --help)" ;;
esac
